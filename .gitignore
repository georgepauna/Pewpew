__pycache__/
*.pyc
save.json
last_run.log
music_cache/
# Per-machine dev tuning of menu-music layer volumes. The values are
# rolled into the hard-coded layer vol= params by hand later, so the
# JSON itself stays local.
_menu_layer_tuning.json
# Local dev/deploy/probe scaffolding (kept out of the repo by convention).
_*.py
# Editors are shared tools — kept tracked so changes flow with the repo.
!_layout_editor.py
!_sprite_editor.py
# Smoke + flow-diagram generators: the screenshots/ folder is committed,
# so the scripts that produce them belong tracked alongside.
!_smoke.py
!_flow_diagram.py
# Money / balance simulation: tracked so the analytic answer to "how
# much credits does a 100% clear earn vs the shop bill" can be
# re-run by anyone with the repo.
!_money_sim.py
_shot_*.png
# BMP conversions of art/sprites/*.png. Tracked in the repo so the
# RG35XX Pro auto-updater can sync them via art/bmp_manifest.json
# (the stock-OS pygame has no SDL_image and can't decode PNG). The
# editor regenerates both BMPs + the hash manifest on save, so commit
# them alongside the PNG / engine / layout JSON changes.
# Bot tooling: ignore the per-run artifacts except the plot + meta. Plots
# are tracked so every sim is reviewable in git history; replays and
# telemetry JSONs stay local (too bulky + regeneratable).
tuning/runs/**
!tuning/runs/
!tuning/runs/*/
!tuning/runs/*/progression.png
!tuning/runs/*/meta.json
replays/
.pewpew.pid
perf_*.txt
mission_replays/
